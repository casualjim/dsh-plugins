{
  "name": "dsh-worktrunk",
  "version": "0.1.0",
  "license": "MIT",
  "description": "worktrunk (wt) git worktree management for DeepSeek Harness: create/list/remove worktrees, sync gitignored files, register worktrees as DSH workspaces",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.5",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
