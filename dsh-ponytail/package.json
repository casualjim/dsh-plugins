    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-jobs": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.5",
