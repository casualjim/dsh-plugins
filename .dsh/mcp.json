{
  "version": 1,
  "servers": [
    {
      "name": "cloudflare-api",
      "transport": "streamable-http",
      "enabled": true,
      "toolCallTimeoutMs": 15000,
      "reconnect": {},
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    {
      "name": "restate-docs",
      "transport": "streamable-http",
      "enabled": true,
      "toolCallTimeoutMs": 15000,
      "reconnect": {},
      "url": "https://docs.restate.dev/mcp"
    },
    {
      "name": "better-auth",
      "transport": "streamable-http",
      "enabled": true,
      "toolCallTimeoutMs": 15000,
      "reconnect": {},
      "url": "https://mcp.better-auth.com/mcp"
    },
    {
      "name": "timescaledb",
      "transport": "streamable-http",
      "enabled": true,
      "toolCallTimeoutMs": 15000,
      "reconnect": {},
      "url": "https://mcp.tigerdata.com/docs"
    },
    {
      "name": "kubernetes-mcp-server",
      "transport": "stdio",
      "enabled": true,
      "toolCallTimeoutMs": 15000,
      "reconnect": {},
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest"
      ]
    },
    {
      "name": "rust-docs",
      "transport": "stdio",
      "enabled": true,
      "toolCallTimeoutMs": 15000,
      "reconnect": {},
      "command": "docsrs-mcp"
    }
  ]
}