{
  "name": "dsh-codebase-memory",
  "version": "0.1.0",
  "license": "MIT",
  "description": "codebase-memory-mcp knowledge-graph integration as a DeepSeek Harness bundle: MCP bridge row, tiered native subagents (scout/verify/auditor), skill, and graph-first behavior hooks",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tool-subagent": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-subagent": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-tool-subagent": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.5",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
